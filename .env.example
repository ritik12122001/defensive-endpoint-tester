# =====================================================================
# Configuration Example (.env.example)
# Copy this file to .env and fill in your authorized credentials.
# =====================================================================

TARGET_URL=http://127.0.0.1:8000/
MAX_THREADS=4
TOTAL_REQUESTS=10
REQUEST_TIMEOUT=10.0
USER_AGENT=DefensiveHttpClient/1.0

MAX_RETRIES=3
BACKOFF_FACTOR=0.5

# Proxy Configuration
# Supports: IP:PORT:USERNAME:PASSWORD or standard http://username:password@host:port
# Use newline-separated or comma-separated lists
PROXY_LIST="
192.0.2.1:8080:placeholder_username:placeholder_password
192.0.2.2:8080:placeholder_username:placeholder_password
"

# Set REQUIRE_PROXY=true to enforce that requests NEVER execute directly if proxies fail
REQUIRE_PROXY=true
MAX_PROXY_RETRIES=2
